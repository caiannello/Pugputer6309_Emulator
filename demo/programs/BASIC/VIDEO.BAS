10 REM THE VIDEO CARD FROM BASIC: SCREEN, PALETTE, LINE, CIRCLE, TRIANGLE,
20 REM PSET, GPRINT, TPRINT, IMAGE, SPRITE, VSYNC AND VPOKE
30 SCREEN 1:GCLS
40 REM A SKY: 16 COLORS OF OUR OWN, FROM DEEP BLUE TO ORANGE
50 FOR I=0 TO 15:PALETTE 240+I,I*16,I*6,120-I*6:NEXT
60 FOR I=0 TO 15:LINE (0,I*10)-(319,I*10+9),240+I,BF:NEXT
70 REM STARS, A SUN, MOUNTAINS
80 FOR I=1 TO 60:PSET (RND(320)-1,RND(80)-1),231:NEXT
90 CIRCLE (160,125),38,214,F
100 FOR Y=127 TO 159 STEP 7:LINE (110,Y)-(210,Y+1),240+INT(Y/10),BF:NEXT
110 TRIANGLE (-20,160)-(50,112)-(120,160),53
120 TRIANGLE (200,160)-(270,104)-(340,160),53
130 REM THE GROUND AND ITS GRID
140 LINE (0,160)-(319,239),16,BF
150 FOR X=-480 TO 800 STEP 80:LINE (160,160)-(X,239),201:NEXT
160 Y=160:D=2
170 LINE (0,Y)-(319,Y),201:Y=Y+D:D=D+2:IF Y<240 THEN 170
180 CIRCLE (290,30),14,231:CIRCLE (290,30),10,231
190 GPRINT (84,4),"BASIC ON THE VIDEO CARD",231
200 TPRINT (29,28),"PRESS ANY KEY TO QUIT",7,16
210 REM SIX BALLS: SPRITE IMAGES, DRAWN LIKE THE REST
220 FOR I=0 TO 5:READ C:IMAGE I:GCLS 0:CIRCLE (7,7),7,C,F:CIRCLE (5,5),2,231,F:NEXT:IMAGE
230 DATA 196,208,226,46,51,129
240 DIM X(5),Y(5),U(5),V(5)
250 FOR I=0 TO 5:X(I)=20+I*48:Y(I)=20+I*30:U(I)=2+I-INT(I/3)*3:V(I)=1+I-INT(I/2)*2:NEXT
260 REM EACH FRAME: MOVE THE BALLS, PULSE THE SUN, BOB THE WORDS
270 FOR I=0 TO 5
280 X(I)=X(I)+U(I):IF X(I)<0 OR X(I)>304 THEN U(I)=-U(I):X(I)=X(I)+U(I)
290 Y(I)=Y(I)+V(I):IF Y(I)<0 OR Y(I)>224 THEN V(I)=-V(I):Y(I)=Y(I)+V(I)
300 SPRITE I,X(I),Y(I),I,-(I>2)*4
310 NEXT
320 T=T+1:PALETTE 214,255,150+INT(60*SIN(T/8)),0
330 VPOKE 262203,ABS((T AND 7)-4)
340 VSYNC:IF INKEY$="" THEN 270
350 SCREEN 0:END
