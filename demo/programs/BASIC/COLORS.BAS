10 REM COLORS ON AN ANSI TERMINAL: CLS, GOTOXY, LCOLOR, HCOLOR, RESET
20 CLS:PRINT "LCOLOR(FG,BG): THE 256-COLOR PALETTE"
30 FOR C=0 TO 255
40 Y=INT(C/16)+2:X=(C AND 15)*4+5
50 IF X=5 THEN RESET:GOTOXY(0,Y):PRINT C;
60 GOTOXY(X,Y):LCOLOR(0,C):PRINT "    ";
70 NEXT C
80 RESET:GOTOXY(0,19):PRINT "HCOLOR(R,G,B,R,G,B): 24-BIT COLOR"
90 FOR I=0 TO 63:V=INT(I*4.05):HCOLOR(0,0,0,V,0,255-V):PRINT " ";:NEXT I:RESET:PRINT
100 FOR I=0 TO 63:V=INT(I*4.05):HCOLOR(0,0,0,V,V,V):PRINT " ";:NEXT I:RESET:PRINT
