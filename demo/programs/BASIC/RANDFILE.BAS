10 REM RANDOM-ACCESS FILE DEMO
20 OPEN "R",#1,"PHONE.DAT",32
30 FIELD #1,20 AS N$,12 AS T$
40 FOR I=1 TO 3
50 READ A$,B$
60 LSET N$=A$:LSET T$=B$
70 PUT #1,I
80 NEXT I
90 FOR I=3 TO 1 STEP -1
100 GET #1,I:PRINT I;N$;T$
110 NEXT I
120 CLOSE #1:KILL "PHONE.DAT"
130 DATA "ADA LOVELACE","555-0101","ALAN TURING","555-0102","GRACE HOPPER","555-0103"
