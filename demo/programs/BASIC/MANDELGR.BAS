10 REM MANDEL.BAS ON THE VIDEO CARD: 320X240 IN 24 COLORS, CYAN TO MAGENTA
20 REM BY HOW SOON EACH POINT ESCAPES; THE SET ITSELF STAYS BLACK
30 REM THE BUSIEST VARIABLES FIRST: BASIC FINDS THEM SOONER. NUMBERS USED
40 REM OVER AND OVER GO IN VARIABLES: A VARIABLE IS QUICKER THAN A NUMBER
50 A=0:B=0:T=0:U=0:C=0:D=0:F=4:I=0:E=0:G=0:P=0:Q=0:X=0:Y=0:V=.25:Z=.0625:O=1
60 SCREEN 1:GCLS
70 FOR I=1 TO 24:R=INT((I-1)*255/23):PALETTE I,R,255-R,255:NEXT
80 PRINT "DRAWING THE MANDELBROT SET (IT TAKES A WHILE)"
90 REM THE VIEW: X FROM -2.24 TO 0.56, Y FROM -0.915 TO 0.915
100 L=-2.24:H=2.8/320:K=1.83/240
110 REM IT'S THE SAME ABOVE AND BELOW THE AXIS: EACH ROW IS DRAWN TWICE
120 FOR Y=0 TO 119:D=(Y-119.5)*K:E=D*D:G=E/4:W=239-Y:C=L-H
130 FOR X=0 TO 319:C=C+H
140 REM INSIDE THE BIG CARDIOID OR THE CIRCLE LEFT OF IT: IN THE SET
150 P=C-V:Q=P*P+E:IF Q*(Q+P)<G THEN 200
160 P=C+O:IF P*P+E<Z THEN 200
170 A=0:B=0:T=0:U=0
180 FOR I=1 TO 24:B=A*B:B=B+B+D:A=T-U+C:T=A*A:U=B*B:IF T+U<F THEN NEXT I
190 IF I<25 THEN PSET (X,Y),I:PSET (X,W),I
200 NEXT X,Y
210 PRINT "PRESS ANY KEY TO QUIT"
220 IF INKEY$="" THEN 220
230 SCREEN 0:END
