# Not part of the repository
# lwtools binaries (not part of the repository; see README.md): the contents of
# lwtools/win_bin (Windows) and lwtools/linux_bin (Linux), all but their READMEs
/lwtools/*
!/lwtools/win_bin/
!/lwtools/linux_bin/
/lwtools/win_bin/*
/lwtools/linux_bin/*
!/lwtools/win_bin/README.md
!/lwtools/linux_bin/README.md
/lwtools-*/
/dist/
/Claude_Readme/
/.vscode/

# Build trees
/build/
/simulator/build/
/simulator/build-release/
/simulator/build-release-linux/

# Generated by bios/compile.bat, dos/compile.bat, shell/compile.bat, edit/compile.bat,
# pugasm/compile.bat,
# basic309/build_basic.bat and reinit_disk.bat (and their .sh counterparts on Linux) --
# rebuild with reinit_disk.bat or reinit_disk.sh (needs lwtools -- see README.md)
/bios/*.o
/bios/*.lst
/bios/*.hex
/bios/*.map
/bios/*.s19
/dos/dos.bin
/dos/dos.lst
/basic309/*.lst
/basic309/*.s19
/basic309/disk.img
/shell/shell.bin
/shell/shell.lst
/edit/edit.bin
/edit/edit.lst
/pugasm/pugasm.bin
/pugasm/pugasm.lst
/pugasm/puglink.bin
/pugasm/puglink.lst
